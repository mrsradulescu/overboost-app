{
  "id": "bclog",
  "title": "BC Logger",
  "description": "Passive recorder: logs every signal the head unit sees while you use the BC button, the steering-wheel thumb wheel or a cluster menu. Sends nothing to the car",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OA9G",
  "maxDiskUsage": 104857600,
  "iconGlyph": "LOG",
  "signals": {
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs",
      "statusPushButtonsState": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "ccList": "rs",
      "newCCMessage": "rs",
      "cbsDataServiceList": "rs",
      "cbsDataSBA": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "basicList": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusActualValueTorque2": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "statusMSystem": "rs",
      "dataDisplayGearbox": "s",
      "_optional": "log of this interface"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s",
      "_optional": "log of this interface"
    }
  },
  "screens": [
    {
      "name": "MAIN",
