  "settings": [
    {
      "key": "autoStart",
      "label": "Log from app start",
      "type": "bool",
      "default": true
    },
    {
      "key": "minMs",
      "label": "Min. gap per signal",
      "type": "number",
      "unit": "ms",
      "default": 50,
      "steps": [
        0,
        20,
        50,
        100,
        250,
        1000
      ]
    },
    {
      "key": "cap",
      "label": "Max. lines per second",
      "type": "number",
      "unit": "/s",
      "default": 1000,
      "steps": [
        200,
        500,
        1000,
        3000
      ]
    },
    {
      "key": "fileMB",
      "label": "New file after",
      "type": "number",
      "unit": "MB",
      "default": 10,
      "steps": [
        2,
        5,
        10,
        20
      ]
    }
  ],
