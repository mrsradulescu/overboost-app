{
  "id": "bclog8",
  "title": "BC / ECU Logger",
  "description": "Recorder for iDrive 8: listens to SOME/IP signals (BC button / steering wheel / cluster) and reads the engine ECU over UDS, read only (check-engine lamp = BC menu, ethanol, DIDs).",
  "version": "0.3.0",
  "loggingId": "OA9G",
  "maxDiskUsage": 104857600,
  "signals": {
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs",
      "statusPushButtonsState": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "ccList": "rs",
      "newCCMessage": "rs",
      "cbsDataServiceList": "rs",
      "cbsDataSBA": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "basicList": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusActualValueTorque2": "rs",
      "_optional": "log of this interface"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "statusMSystem": "rs",
      "dataDisplayGearbox": "s",
      "_optional": "log of this interface"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s",
      "_optional": "log of this interface"
    }
  },
  "config": {
    "minMs": 50,
    "cap": 1000,
    "fileMB": 10,
    "capMB": 40,
    "autoStart": true,
    "watch": {
      "de.bmw.infotainment.controlelements.FrontCCU": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusRotaryEncoderState",
          "statusPushButtonsState"
        ],
        "events": []
      },
      "de.bmw.infotainment.KombiInterface_2": {
        "instances": [
          "1"
        ],
        "fields": [
          "ccList",
          "newCCMessage",
          "cbsDataServiceList",
          "cbsDataSBA"
        ],
        "events": []
      },
      "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
        "instances": [
          "1"
        ],
        "fields": [
          "basicList"
        ],
        "events": []
      },
      "de.bmw.infotainment.vehicle.CDS": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusEngineSpeed2",
          "statusEngineTemperature"
        ],
        "events": []
      },
      "de.bmw.infotainment.vehicle.Vehicle2": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusCarSpeed2"
        ],
        "events": []
      },
      "de.bmw.infotainment.drivingexcitement.FES": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusSwitchDriveDynamicSport2",
          "statusVehicleDynamicEngine",
          "statusActualValueTorque2"
        ],
        "events": []
      },
      "de.bmw.infotainment.misc.MDrive": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusMSystem",
          "dataDisplayGearbox"
        ],
        "events": []
      },
      "de.bmw.infrastructure.VehicleInformation": {
        "instances": [
          "1"
        ],
        "fields": [
          "statusGearboxDrive",
          "DataPowerTrain2"
        ],
        "events": []
      }
    },
    "ecu": {
      "enabled": true,
      "transport": "auto",
      "autoStart": false
    }
  }
}
